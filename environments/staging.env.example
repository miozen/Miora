# Staging environment: non-secret configuration only.
# Supply MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD and JWT_SECRET_KEY at runtime.
COMPOSE_PROJECT_NAME=miora-staging
MYSQL_DATABASE=miora_staging
MYSQL_USER=miora
HTTP_PORT=8080
BLOG_HOST=staging.example.com
ADMIN_HOST=admin.staging.example.com

STORAGE_PROVIDER=local
FILE_PUBLIC_URL=

# For S3, set these non-secret connection values in the runtime environment.
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_REGION=your-region
# STORAGE_S3_BUCKET=miora-staging
# STORAGE_S3_PREFIX=uploads
# STORAGE_S3_PUBLIC_URL=https://images.example.com
# STORAGE_S3_PATH_STYLE=false

# Never place these values in this file or Git:
# MYSQL_PASSWORD
# MYSQL_ROOT_PASSWORD
# JWT_SECRET_KEY
# STORAGE_S3_ACCESS_KEY
# STORAGE_S3_SECRET_KEY
