# Compose 项目名会决定命名卷前缀；生产环境应保持稳定。
COMPOSE_PROJECT_NAME=thrivex

# 必填：请替换为高强度、互不相同的值，勿提交实际 .env 文件。
MYSQL_DATABASE=thrivex
MYSQL_USER=thrivex
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
JWT_SECRET_KEY=replace-with-a-long-random-secret

# 入口反向代理。BLOG_HOST 与 ADMIN_HOST 需要解析到本服务器。
HTTP_PORT=80
BLOG_HOST=example.com
ADMIN_HOST=admin.example.com

# 默认本地存储。经同域 Nginx 部署时 FILE_PUBLIC_URL 保持为空。
STORAGE_PROVIDER=local
FILE_PUBLIC_URL=

# 仅在 STORAGE_PROVIDER=s3 时填写；凭据应由 Secret 管理能力注入。
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_REGION=your-region
# STORAGE_S3_BUCKET=your-bucket
# STORAGE_S3_PREFIX=uploads
# STORAGE_S3_ACCESS_KEY=replace-with-access-key
# STORAGE_S3_SECRET_KEY=replace-with-secret-key
# STORAGE_S3_PUBLIC_URL=https://images.example.com
# STORAGE_S3_PATH_STYLE=false
