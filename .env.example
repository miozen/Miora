COMPOSE_PROJECT_NAME=miora
MYSQL_DATABASE=miora
MYSQL_USER=miora
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Required only on the first start of a fresh database; use a unique password of 12+ characters.
BOOTSTRAP_ADMIN_USERNAME=miora-admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password

# Default production entry points: host-local, not public.
BLOG_BIND_ADDRESS=127.0.0.1
BLOG_PORT=9661
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=9662
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=9663

# Needed only by the development proxy or compose.standalone.yaml.
BLOG_HOST=example.com
ADMIN_HOST=admin.example.com
HTTP_PORT=80
STANDALONE_HTTP_PORT=80
STANDALONE_HTTPS_PORT=443

STORAGE_PROVIDER=local
FILE_PUBLIC_URL=
